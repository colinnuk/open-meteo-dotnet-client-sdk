    </None>
    <None Update="Weather\Forecast\RegionalGeoJSON\ncep_hrrr_conus.geojson">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Weather\Forecast\RegionalGeoJSON\ncep_nam_conus.geojson">
